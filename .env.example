# Set at least one vendor API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Alternatively, run Gemini through Vertex AI with gcloud Application Default
# Credentials instead of an API key. Tokens auto-refresh and expire in 1 hour.
# Run `gcloud auth application-default login` first, then set this to true.
# This takes precedence over GEMINI_API_KEY when both are set.
GEMINI_USE_GCLOUD_AUTH=false
# Optional; ADC usually supplies the project, and location defaults to global.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Optional defaults.
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-3.1-pro-preview
DEFAULT_MODEL=auto

# Optional workflow memory settings.
MATES_CONVERSATION_TTL_SECONDS=10800
MATES_MAX_CONTEXT_CHARS=120000

# Optional model registry settings.
MATES_MODELS_FILE=
MATES_MODEL_DISCOVERY=off
MATES_ALLOW_DEPRECATED_MODELS=false
