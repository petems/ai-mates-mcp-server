# Set at least one vendor API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional defaults.
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-3.1-pro-preview
DEFAULT_MODEL=auto

# Optional workflow memory settings.
MATES_CONVERSATION_TTL_SECONDS=10800
MATES_MAX_CONTEXT_CHARS=120000

# Optional model registry settings.
MATES_MODELS_FILE=
MATES_MODEL_DISCOVERY=off
MATES_ALLOW_DEPRECATED_MODELS=false
