# Set at least one vendor API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional defaults.
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-pro
DEFAULT_MODEL=auto

# Optional workflow memory settings.
MATES_CONVERSATION_TTL_SECONDS=10800
MATES_MAX_CONTEXT_CHARS=120000
